# База MySQL из задания (alexeykamalin/arch). Пароль возьмите из app.py задания.
DB_HOST=185.114.247.43
DB_PORT=3306
DB_NAME=sch688_vvedenie
DB_USER=sch688_vvedenie
DB_PASSWORD=

# Нейросеть Qwen. Скачивается с Hugging Face при первом запуске (~1 ГБ).
# Для слабого компьютера можно взять модель из задания:
#   MODEL_REPO=bartowski/Qwen2.5-0.5B-Instruct-GGUF
#   MODEL_FILE=Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
MODEL_REPO=bartowski/Qwen2.5-1.5B-Instruct-GGUF
MODEL_FILE=Qwen2.5-1.5B-Instruct-Q4_K_M.gguf
# Или путь к уже скачанному файлу .gguf (тогда MODEL_REPO и MODEL_FILE не нужны).
MODEL_PATH=
MODEL_MAX_TOKENS=300
# 1 — загрузить модель сразу при запуске сайта.
PRELOAD_MODEL=1

# Стоимость одного вопроса к нейросети (списывается с баланса, пишется в transactions).
# 0 — вопросы бесплатные.
CHAT_COST=1
# Значения колонки type в transactions. Если в базе другие — впишите их здесь.
TX_TYPE_CHARGE=charge
TX_TYPE_DEPOSIT=deposit

# Ключ сессий. Если пусто, создаётся автоматически в папке instance.
SECRET_KEY=
# 1 только для сайта на HTTPS. Дома оставьте 0.
COOKIE_SECURE=0
